# Виртуальное окружение
venv/
.venv/
env/

# Кэш Python и байт-код
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Локальные настройки и секреты
.env
*.local
src/**/settings/local.py

# Локальная база данных (если используется SQLite)
*.sqlite3
*.db

# Медиа-файлы и собранная статика
# (обычно они хранятся в Docker volumes или S3, а не в самом образе)
media/
static/
staticfiles/

# Файлы систем контроля версий и IDE
.git/
.gitignore
.gitlab/
.github/
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Логи и кэш инструментов тестирования/линтеров
*.log
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Файлы сборки Docker (не нужны внутри самого контекста)
Dockerfile*
docker-compose*
.dockerignore

# Системные файлы
.DS_Store
Thumbs.db